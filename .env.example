# ─── Postgres ───────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/commodities

# ─── Auth (must match fx-alerfrontend NEXTAUTH_SECRET) ─────────────────────────
NEXTAUTH_SECRET=generate-a-long-random-string
# AUTH_DISABLED=false

# ─── Redis ──────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ─── WebSocket URL returned to authenticated clients ────────────────────────────
WS_URL=ws://localhost:8000/ws/observe

# ─── SMS Gate (https://api.sms-gate.app) ────────────────────────────────────────
SMS_GATE_USERNAME=your_sms_gate_username
SMS_GATE_PASSWORD=your_sms_gate_password
# SMS_GATE_API_URL=https://api.sms-gate.app/3rdparty/v1/message

# ─── Email alerts (optional) ────────────────────────────────────────────────────
# SENDGRID_API_KEY=
# FROM_EMAIL=noreply@example.com

# ─── Call alerts (optional) ─────────────────────────────────────────────────────
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=
# TWILIO_TO_NUMBER=
# TWILIO_CUSTOM_MSG=

# ─── Server ─────────────────────────────────────────────────────────────────────
# PORT=8000
